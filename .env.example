# Salin file ini jadi .env lalu isi nilainya.
#   cp .env.example .env
#
# Ada dua cara memakai bot ini. Pilih salah satu blok, lalu beri tanda #
# pada blok yang tidak dipakai supaya tidak ada dua kunci aktif sekaligus.

# ===========================================================================
# Pilihan A — DeepSeek resmi
# ===========================================================================
# Kunci diambil di https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-isi-di-sini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===========================================================================
# Pilihan B — gateway OpenAI-compatible (misalnya Tokenomix)
# ===========================================================================
# Isi ketiga baris di bawah dengan nilai dari dashboard gateway, lalu hapus
# tanda # di depannya dan beri tanda # pada blok Pilihan A di atas.
#
# Nama model HARUS persis sama dengan yang tertulis di dashboard gateway.
# Untuk DeepSeek biasanya deepseek-chat atau deepseek-reasoner, tapi
# konfirmasi dulu di daftar model mereka.
#
# DEEPSEEK_API_KEY=sk-tkx-kunci-dari-dashboard
# DEEPSEEK_BASE_URL=https://api.tokenomixai.com/v1
# DEEPSEEK_MODEL=glm-5.1

# ===========================================================================
# Wajib di kedua pilihan
# ===========================================================================
# Diambil di https://app.tavily.com  (gratis 1.000 pencarian/bulan)
TAVILY_API_KEY=tvly-isi-di-sini

# ===========================================================================
# Opsional - kunci akses untuk deployment publik
# ===========================================================================
# Kalau diisi, setiap permintaan ke /api/chat wajib membawa header X-Access-Key
# yang cocok. Kosongkan saat mengembangkan di komputer sendiri.
# APP_ACCESS_KEY=ganti-dengan-kalimat-rahasia-panjang

# Opsional - model yang membaca gambar. Kalau dikosongkan, dipakai
# deepseek-v4-flash-vision-exp dari gateway yang sama.
# VISION_MODEL=deepseek-v4-flash-vision-exp

# Opsional - speech to text. Gateway di atas tidak melayani audio, jadi bagian
# ini butuh penyedia lain yang formatnya kompatibel dengan OpenAI.
# Contoh Groq (ada paket gratis): https://console.groq.com/keys
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=gsk-isi-di-sini
# STT_MODEL=whisper-large-v3-turbo

